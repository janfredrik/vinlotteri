# Copy to .env (compose reads it) and fill in.

# Shared PIN that unlocks the whole site. Anyone with it can also administer
# (whoever wins arranges the next round). Put it on the QR poster, or use a
# magic link:  https://vinlotteri.dittdomene.no/runde/5?k=<PIN>
# Leave blank / set to "off" only for a site with no internet exposure.
SITE_PIN=

# Public URL the app is served on (used for absolute links / QR poster)
APP_URL=https://vinlotteri.dittdomene.no

# Optional: free self-service Vinmonopolet API key to auto-fill the prize name.
# Product images always work without it. Price/volume aren't in the self-service
# tier's response either way - type those in regardless.
# Get one at https://api.vinmonopolet.no
VINMONOPOLET_API_KEY=

# Optional: read name/price/varenummer from pasted Vinmonopolet screenshots with a
# vision model. Any OpenAI-compatible /chat/completions endpoint works.
# Defaults: OCR_BASE_URL=https://openrouter.ai/api/v1  OCR_MODEL=google/gemini-2.5-flash
OCR_API_KEY=
OCR_BASE_URL=
OCR_MODEL=

# Optional: post to a Teams channel when a round opens, an hour before sales close,
# and when the winners (and so next week's organiser) are drawn. In Teams: channel ->
# ... -> Workflows -> "Post to a channel when a webhook request is received", then
# paste the URL here. Comma-separate several URLs to post to more channels.
# Links in the messages use APP_URL above.
TEAMS_WEBHOOK_URL=

TZ=Europe/Oslo

# Dev only: let phones on the same Wi-Fi use `npm run dev` via the Mac IP (comma-separated).
DEV_ORIGINS=
